{
  "name": "hebrew-academization-results-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGIN": "https://YOUR_USERNAME.github.io",
    "REQUIRE_PIN": "true"
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "hebrew-academization-results", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"}
  ]
}
